{
  "expo": {
    "name": "KwikServe",
    "slug": "QuickServe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kwikserve-icon-1024.png",
    "scheme": ["kwikserve", "quickserve"],
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "icon": "./assets/images/kwikserve-icon-1024.png",
      "bundleIdentifier": "ke.co.hiredcorp.kwikserve",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00875A",
        "foregroundImage": "./assets/images/kwikserve-adaptive-foreground.png",
        "backgroundImage": "./assets/images/kwikserve-adaptive-background.png",
        "monochromeImage": "./assets/images/kwikserve-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ke.co.hiredcorp.kwikserve",
      "versionCode": 1,
      "allowBackup": false,
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/kwikserve-favicon-48.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00875A",
          "image": "./assets/images/kwikserve-splash-mark.png",
          "imageWidth": 200
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "KwikServe needs photo access to attach job photos.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KwikServe shares your live location with the customer only while you are travelling to and performing an active job.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      ["@sentry/react-native/expo", { "organization": "", "project": "" }]
    ],
    "extra": {
      "eas": {
        "projectId": "587f8663-a722-4882-ab56-9007413003ee"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "dalmarmudu"
  }
}
