# QuickServe QA — copy to qa/.env (never commit qa/.env).

# Base URL of the Admin Web app under test.
# If set, Playwright uses it directly and does NOT start a server.
# If unset, Playwright auto-starts `expo start --web` and uses http://localhost:8081.
# BASE_URL=http://localhost:8081

# Admin test account (MUST already exist — this framework never creates accounts).
# If unset, authenticated storageState setup is skipped and only the public smoke runs.
# E2E_ADMIN_EMAIL=qa.admin@example.com
# E2E_ADMIN_PASSWORD=change-me

# ── Launch Certification (QA Slice 44A) — CONNECTED, dedicated QA/staging only ──
# A DEDICATED QA/staging Supabase project (NEVER production, NEVER the app URL).
# The certification suite skips cleanly unless ALL of these are set.
# QA_SUPABASE_URL=https://<qa-project>.supabase.co
# QA_SUPABASE_ANON_KEY=<qa anon key>
# QA_SERVICE_ROLE_KEY=<qa service-role key>   # provisioning script ONLY; never used by tests
# Four persistent accounts (provision once via: node qa/scripts/provision-accounts.mjs)
# QA_CUSTOMER_EMAIL=qa.customer@example.com
# QA_CUSTOMER_PASSWORD=change-me
# QA_ADMIN_EMAIL=qa.admin@example.com
# QA_ADMIN_PASSWORD=change-me
# QA_PROVIDER1_EMAIL=qa.provider1@example.com
# QA_PROVIDER1_PASSWORD=change-me
# QA_PROVIDER2_EMAIL=qa.provider2@example.com
# QA_PROVIDER2_PASSWORD=change-me
